#include <HardwareSerial.h>
#include <DFRobotDFPlayerMini.h>

#define MP3_RX 16
#define MP3_TX 17


HardwareSerial dfSerial(2);
DFRobotDFPlayerMini player;

void setup() {
  Serial.begin(115200);
  dfSerial.begin(9600, SERIAL_8N1, MP3_RX, MP3_TX);

  if (!player.begin(dfSerial)) {
    Serial.println("Khong ket noi duoc voi DFPlayer Mini!");
    while (true) {
      delay(1000);
    }
  }
  Serial.println("DFPlayer Mini san sang!");
  player.volume(20);
  player.play(1);
}

void loop() {
}
